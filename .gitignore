# ==========================================
# Root Git Ignore - Laboratory Medical365 LMS
# ==========================================

# Dependencies
node_modules/
*/node_modules/
*/*/node_modules/
.pnp
.pnp.js

# Production & Build Outputs
dist/
*/dist/
*/*/dist/
build/
*/build/
*/*/build/
dist-ssr/

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.env
*.env.*
!*.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor, IDE & System Files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Temporary & Cache Files
.temp/
.tmp/
tmp/
*.tmp
*.bak
*.orig
.cache/
.eslintcache

# Offline Image Archives & Installer Distributables (kept locally, not in Git)
LabManagementSystem/installer_dist/*.exe
LabManagementSystem/installer_dist/*.tar
LabManagementSystem/installer_dist/*.zip
!LabManagementSystem/installer_dist/offline-images-manifest.json
!LabManagementSystem/installer_dist/offline-images.sha256

# Database Backup Archives & Dry-Run Artifacts
*.bson
*.dump
*.archive
.test_dryrun_backup/
LabManagementSystem/.test_dryrun_backup/
lms_local_mongo_backup.tar.gz
LabManagementSystem/lms_local_mongo_backup.tar.gz

# Local License Key Tokens (kept locally, not in Git)
LabManagementSystem/docker/license.key
LabManagementSystem/server/license.key

# Standalone Git Bundles
*.bundle