# Lab Management System (LMS) - Client Environment Configuration Template
# -----------------------------------------------------------------------------
# Local Development:
# When running locally with backend on port 5000, leave unset to use Vite proxy (/api/v1)
# or set explicitly to:
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_TITLE=Medical365 Laboratory Management System

# -----------------------------------------------------------------------------
# Production Deployment (e.g. Vercel):
# Set this to your live Render/cloud backend API URL (with /api/v1 suffix):
# Example:
# VITE_API_BASE_URL=https://<your-render-service>.onrender.com/api/v1
