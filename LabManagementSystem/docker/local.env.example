# ==============================================================================
# Lab Management System (LMS) - Local On-Premise Edition Environment Configuration
# ==============================================================================
# COPY THIS FILE TO docker/local.env BEFORE STARTING DOCKER COMPOSE:
#   cp docker/local.env.example docker/local.env
#
# WARNING: This file is for the Local On-Premise Edition only.
# Never enter cloud Atlas credentials or production cloud URLs in this file.

# ------------------------------------------------------------------------------
# 1. LMS Deployment Edition & Runtime Mode
# ------------------------------------------------------------------------------
LMS_EDITION=local
NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# 2. Network & LAN Configuration
# ------------------------------------------------------------------------------
# The LAN port published by the Nginx reverse proxy on the central Windows server.
# Port 80 is recommended for standard browser access: http://<server-lan-ip>
FRONTEND_PORT=80

# CORS Allowed Origins:
# In Local Edition, LAN IP subnets (192.168.x.x, 10.x.x.x, 172.16-31.x.x) are allowed
# automatically. Add any custom workstation hostnames or internal DNS names here:
CORS_ORIGINS=http://localhost,http://127.0.0.1

# ------------------------------------------------------------------------------
# 3. Local Isolated MongoDB Configuration (Docker Network)
# ------------------------------------------------------------------------------
# FAIL-CLOSED ENFORCEMENT: The server will refuse to start if MONGODB_URI points to
# MongoDB Atlas (*.mongodb.net) or an unapproved external WAN address.
DB_AUTO_CONNECT=true
MONGODB_URI=mongodb://lms_app_user:lms_local_secure_pass@mongo:27017/lms_master?authSource=admin
MONGODB_MASTER_DB_NAME=lms_master

# MongoDB Root Admin credentials (used only for DB maintenance inside the container)
MONGO_ROOT_USER=lms_root_admin
MONGO_ROOT_PASSWORD=replace_with_secure_local_root_password_at_least_16_chars

# MongoDB Application Dedicated User credentials (used by backend)
MONGO_APP_USER=lms_app_user
MONGO_APP_PASSWORD=lms_local_secure_pass

# Multi-Tenant Strategy
TENANT_DB_STRATEGY=isolated_db
TENANT_DB_NAME_PREFIX=lms_lab_
TENANT_PROVISIONING_MODE=auto

# ------------------------------------------------------------------------------
# 4. Security Keys & JWT Secrets (Local Instance)
# ------------------------------------------------------------------------------
# REQUIRED: Must be at least 24 (API key) and 32 (secrets) characters long.
# Change these values before deploying to a live diagnostic laboratory!
SUPER_ADMIN_API_KEY=replace_with_a_secure_local_admin_key_at_least_24_chars_long
JWT_SECRET=replace_with_a_secure_local_jwt_secret_at_least_32_chars_long
JWT_EXPIRES_IN=7d
JWT_ISSUER=lms-local-auth
JWT_AUDIENCE=lms-local-api
COOKIE_SECRET=replace_with_a_secure_local_cookie_secret_at_least_32_chars_long

# ------------------------------------------------------------------------------
# 5. Initial Super Administrator Bootstrap Credentials
# ------------------------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=superadmin@local.lms.health
BOOTSTRAP_ADMIN_PASSWORD=replace_with_secure_local_admin_password
BOOTSTRAP_ADMIN_NAME=Local System Administrator

# ------------------------------------------------------------------------------
# 6. Default Local Laboratory Provisioning (Phase 3)
# ------------------------------------------------------------------------------
# Automatically provision the default local laboratory and initial admin on first boot.
LOCAL_BOOTSTRAP_ENABLED=true
LOCAL_LAB_NAME=Main Clinical Laboratory
LOCAL_LAB_CODE=main-lab
LOCAL_LAB_EMAIL=contact@locallab.com
LOCAL_LAB_ADMIN_NAME=Laboratory Administrator
LOCAL_LAB_ADMIN_EMAIL=admin@locallab.com
LOCAL_LAB_ADMIN_PASSWORD=replace_with_secure_lab_admin_password
