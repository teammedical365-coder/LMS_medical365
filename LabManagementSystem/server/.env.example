# ==============================================================================
# Lab Management System (LMS) - Server Environment Configuration Template
# ==============================================================================
# SAFE TEMPLATE: Contains placeholders only. Never commit real credentials or production secrets.

# Application Server
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database Configuration (Master Registry Database)
# Set DB_AUTO_CONNECT=true when connecting to live MongoDB Atlas
DB_AUTO_CONNECT=true
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.jweq8ib.mongodb.net/?appName=Cluster0
MONGODB_MASTER_DB_NAME=lms_master

# Multi-Tenant Database Strategy
TENANT_DB_STRATEGY=isolated_db
TENANT_DB_NAME_PREFIX=lms_lab_
TENANT_PROVISIONING_MODE=auto

# Super Admin Platform Management Security (Phase 2 Authorization Boundary)
# Set a strong key for testing/securing Super Admin API access
SUPER_ADMIN_API_KEY=dev-super-admin-key-change-in-production

# JWT & Session Authentication (Phase 3)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=1h
JWT_ISSUER=lms-platform-auth
JWT_AUDIENCE=lms-api
COOKIE_SECRET=replace_with_a_secure_cookie_signing_secret

# Initial Super Admin Bootstrap (Run via npm run bootstrap:admin)
BOOTSTRAP_ADMIN_EMAIL=superadmin@platform.lms.health
BOOTSTRAP_ADMIN_PASSWORD=replace_with_secure_admin_password
BOOTSTRAP_ADMIN_NAME=Platform Super Administrator
